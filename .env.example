# ==============================================================================
# NYAYA AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure the values for your local environment.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# Backend Service Configuration
APP_NAME="Nyaya AI Backend"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# AI / LLM Configuration (Agreed Stack: Google Gemini API)
# Options: "mock" (for local testing without API keys), "gemini"
LLM_PROVIDER="gemini"
GEMINI_API_KEY="AQ.Ab8RN6LpCkNXBamLIW2g5k_H3aRy9yCeMdxuW8jDVU99p1UfMw"
GEMINI_MODEL="gemini-3.5-flash"

# Embedding Provider Configuration
# Options: "mock", "gemini", "fastembed"
EMBEDDING_PROVIDER="mock"
EMBEDDING_API_KEY=""

# Relational Database (Agreed Stack: SQLite)
DATABASE_URL="sqlite:///./nyaya_ai.db"

# Vector Database (Agreed Stack: ChromaDB)
CHROMA_PERSIST_DIRECTORY="./chroma_db"

# Frontend Configuration (Used when building or running frontend)
VITE_API_BASE_URL="http://localhost:8000"
